  "usage_examples": {
    "python_simple": [
      "# Load stopwords",
      "import json",
      "with open('korean_legal_stopwords.json', 'r', encoding='utf-8') as f:",
      "    data = json.load(f)",
      "    stopwords = data['combined_lists']['all_particles_flat']"
    ],
    "python_with_konlpy": [
      "from konlpy.tag import Okt",
      "okt = Okt()",
      "text = '피고는 원고에게 손해배상을 하여야 한다'",
      "tokens = [word for word in okt.morphs(text) if word not in stopwords]"
    ]
  },
