      "description": "Part-of-speech tags that typically indicate stopwords",
      "tags": ["Josa", "Eomi", "Suffix"],
      "note": "When using morphological analyzer, filter by POS tags instead of word lists"
    },
    "mecab_tags": {
      "description": "Mecab-specific tags for particles",
      "tags": [
        "JKS", "JKC", "JKG", "JKO", "JKB", "JKV", "JKQ", "JX", "JC",
        "EP", "EF", "EC", "ETN", "ETM",
        "XSN", "XSV", "XSA"
